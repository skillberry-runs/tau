+        'id': ...}`` with no ``payment_id``/``amount``). Well-formed ``Payment``
+        objects and ``{'payment_id','amount'}`` dicts pass through unchanged.
+        """
+        if isinstance(pm, Payment):
+            return pm
+        if isinstance(pm, dict):
+            data = dict(pm)
